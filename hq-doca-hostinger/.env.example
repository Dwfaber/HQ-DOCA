# HQ-DOCA Environment Variables
# Copie para .env e preencha com seus valores

# ==================== Hostinger ====================
HOSTINGER_API_TOKEN=seu_token_aqui

# ==================== Supabase ====================
POSTGRES_PASSWORD=sua_senha_segura
DATABASE_URL=postgresql://postgres:sua_senha@supabase-db:5432/hq_doca
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=seu_anon_key
SUPABASE_SERVICE_KEY=seu_service_key

# ==================== Logto Auth ====================
LOGTO_ENDPOINT=https://auth.docaperformance.com.br
LOGTO_APP_ID=seu_app_id
LOGTO_APP_SECRET=seu_app_secret

# ==================== API Keys ====================
ANTHROPIC_API_KEY=sua_api_key_anthropic
OPENAI_API_KEY=sua_api_key_openai
